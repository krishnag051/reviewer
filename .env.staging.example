# Fix Round: template for docker-compose.staging.yml's backend service.
# Copy this to `.env.staging` (gitignored, never committed) and fill in
# your own values. Everything non-secret for staging (DB creds, JWT
# secret, ports, CORS origin) is already hardcoded directly in
# docker-compose.staging.yml -- this file exists only for the couple of
# values that shouldn't sit in a committed file.

# Free-tier default for local iteration, per this repo's own standing
# convention (see document/BrightPath_Deployment_Playbook.md section 6:
# "Use the free OpenRouter model by default; only enable real Anthropic
# calls with an explicit approved call count"). Get your own key at
# https://openrouter.ai/ -- never share/commit a real one.
OPENROUTER_API_KEY=

# Deliberately left blank on purpose -- do NOT paste a real key in here.
# Per CLAUDE.md's hard rule, any real Anthropic API spend (including from
# this staging instance) needs explicit, per-instance approval first, with
# an estimate of how many calls/how much it will cost. Leaving this unset
# makes real rule-checking calls fail closed instead of silently spending
# real money the moment someone uploads a real-looking treatment plan to
# the staging frontend.
ANTHROPIC_API_KEY=

# Optional -- only needed if a staging test specifically needs to exercise
# the real correction-email send path. Leave blank otherwise; mailer.py
# raises a clear, typed error instead of silently pretending to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
